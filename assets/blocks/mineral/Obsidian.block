/**
 * Obsidian: what a spring of lava leaves behind when the water finds it.
 *
 * It is what a source sets into, where the tongue it fed only makes basalt - a
 * source is inexhaustible, so quenching one is worth the harder stone. Nothing
 * in the world generates it: every block of it in a save was made by a player
 * turning water on lava.
 *
 * TODO texture: Black volcanic glass, faintly violet, catching the light in
 * hard flecks rather than in an even grain. The tile is a recoloured copy of
 * HardStone, and the normal map is HardStone's own.
 */
{
    "basedOn": "CoreAssets:rock3",
    "displayName": "Obsidienne",
    "tile": "CoreAssets:Obsidian"
}
