/**
 * Grass is a little more interesting as its tiles differ, but it no longer has to say so:
 * Grass.png covers the top, GrassSides.png the four sides and GrassBottom.png the underside,
 * each picked up from its name. Only the colouring is left to declare.
 */
{
    "basedOn": "CoreAssets:soil",
    "grass": true,
    // Works as an Enum :-)
    "colorSource": "color_lut",
    "colorSources": {
        "bottom": "default"
    }
}
