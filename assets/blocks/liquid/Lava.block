/**
 * Don't fall in the lava - a warmth of fifteen burns for eight a second.
 * It runs half as far as water and is more than twice as thick to cross.
 * There is only ever this one lava block, whatever the surface looks like:
 * the flow solver keeps the distance from the source out of the block, in a
 * four bit per-block data field, and the mesher reads it back to slope the
 * top. A block carries no state of its own to put it in.
 */
{
    "liquid": true,
    // Let the lava shine!
    "luminance": 15,
    // And let all of that light be the orange of molten rock, not a flame's near white.
    "warmth": 15,
    "hardness": 0,
    // Four blocks out from its source, and thick enough to wade at three eighths speed.
    "flowRange": 4,
    "viscosity": 10,
    "attachmentAllowed": false,
    "translucent": true,
    "targetable": false,
    "penetrable": true,
    "shadowCasting": false,
    "replacementAllowed": true,
    "tint": [0.3, 0.2, 0.2],
    "tile": "CoreAssets:Lava",
    "entity": {
        "prefab": "CoreAssets:lava"
    }
}
